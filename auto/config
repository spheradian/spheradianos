#!/bin/sh
# live-build configuration for XSphereOS. Run via scripts/build.sh.
set -e

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main" \
	--debootstrap-options "--variant=minbase" \
	--apt-recommends false \
	--apt-indices false \
	--updates true \
	--security true \
	--linux-flavours amd64 \
	--binary-image iso-hybrid \
	--bootloaders "grub-efi,syslinux" \
	--debian-installer none \
	--memtest none \
	--chroot-squashfs-compression-type xz \
	--iso-application "XSphereOS" \
	--iso-publisher "XSphereOS project" \
	--iso-volume "XSPHEREOS" \
	--bootappend-live "boot=live components quiet splash=0 hostname=xsphereos username=xsphere" \
	"${@}"
