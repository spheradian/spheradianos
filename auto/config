#!/bin/sh
# live-build configuration for XSphereOS. Run via scripts/build.sh.
set -e

lb config noauto \
	--mode debian \
	--distribution trixie \
	--architectures amd64 \
	--archive-areas "main" \
	--debootstrap-options "--variant=minbase" \
	--apt-recommends false \
	--apt-indices false \
	--updates true \
	--security true \
	--linux-flavours amd64 \
	--binary-image iso-hybrid \
	--bootloaders "grub-efi,syslinux" \
	--debian-installer none \
	--memtest none \
	--firmware-binary false \
	--firmware-chroot false \
	--chroot-squashfs-compression-type zstd \
	--iso-application "XSphereOS" \
	--iso-publisher "XSphereOS project" \
	--iso-volume "XSPHEREOS" \
	--bootappend-live "boot=live components quiet splash loglevel=0 rd.systemd.show_status=false systemd.show_status=false rd.udev.log_level=3 udev.log_level=3 vt.global_cursor_default=0 hostname=xsphereos username=xsphere" \
	"${@}"
