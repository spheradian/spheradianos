# XSphereOS boot splash (docs/BOOT-EXPERIENCE.md, milestones B2 and B3).
# GENERATED by scripts/gen-boot-assets.py from scripts/boot_timeline.py. Do not edit.
#
# A seed of light appears, grows and breathes; its light spreads and reveals a
# lattice of dots on a slowly turning sphere, whose regions wake as the system
# really comes up. Nothing is stored as frames: tiny images placed by arithmetic. Esc (boot details) is handled by plymouthd.

motion = 0;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

side = Window.GetWidth();
if (Window.GetHeight() < side) { side = Window.GetHeight(); }
radius = side * 0.24;
centre_x = Window.GetX() + Window.GetWidth() / 2;
centre_y = Window.GetY() + Window.GetHeight() / 2;
degree = 0.017453;
sin_tilt = 0.34202;
cos_tilt = 0.939693;

# Seed: pre-scaled once, so animating it only swaps images.
seed_source = Image("seed.png");
seed_steps = 12;
seed_low = 0.1092;
seed_high = 0.9374;
for (i = 0; i < seed_steps; i++) {
    fraction = seed_low + (seed_high - seed_low) * i / (seed_steps - 1);
    seed_width[i] = Math.Int(radius * 1.2 * fraction) + 2;
    seed_image[i] = seed_source.Scale(seed_width[i], seed_width[i]);
}
seed = Sprite();
seed.SetOpacity(0);

# Lattice: dots along the meridians, plus the dots between them on the parallels.
dot_width = Math.Int(radius / 14);
if (dot_width < 6) { dot_width = 6; }
dot_source = Image("dot.png");
dot_image = dot_source.Scale(dot_width, dot_width);
dot_count = 0;
for (lon = 0; lon < 360; lon = lon + 30) {
    for (lat = -80; lat < 90; lat = lat + 10) {
        dot_sin_lat[dot_count] = Math.Sin(lat * degree);
        dot_cos_lat[dot_count] = Math.Cos(lat * degree);
        dot_lon[dot_count] = lon * degree;
        dot_region[dot_count] = Math.Int(lon / 60);
        dot_count++;
    }
}
parallel_lat[0] = -60;
parallel_lat[1] = -30;
parallel_lat[2] = 0;
parallel_lat[3] = 30;
parallel_lat[4] = 60;
for (p = 0; p < 5; p++) {
    for (lon = 0; lon < 360; lon = lon + 30) {
        for (inner = 1; inner <= 2; inner++) {
            dot_sin_lat[dot_count] = Math.Sin(parallel_lat[p] * degree);
            dot_cos_lat[dot_count] = Math.Cos(parallel_lat[p] * degree);
            dot_lon[dot_count] = (lon + inner * 10) * degree;
            dot_region[dot_count] = Math.Int((lon + inner * 10) / 60);
            dot_count++;
        }
    }
}
for (i = 0; i < dot_count; i++) {
    dot[i] = Sprite(dot_image);
    dot[i].SetOpacity(0);
}

# Honest progress: systemd reports each service that finishes starting. A region
# of the lattice wakes, taking its colour, when its milestone service is up.
region_count = 6;
milestone[0] = "systemd-journald.service";  # logging
region_source = Image("dot-0.png");
region_image[0] = region_source.Scale(dot_width, dot_width);
milestone[1] = "systemd-udevd.service";  # devices
region_source = Image("dot-1.png");
region_image[1] = region_source.Scale(dot_width, dot_width);
milestone[2] = "systemd-tmpfiles-setup.service";  # filesystems
region_source = Image("dot-2.png");
region_image[2] = region_source.Scale(dot_width, dot_width);
milestone[3] = "dbus.service";  # message bus
region_source = Image("dot-3.png");
region_image[3] = region_source.Scale(dot_width, dot_width);
milestone[4] = "systemd-logind.service";  # seats and login
region_source = Image("dot-4.png");
region_image[4] = region_source.Scale(dot_width, dot_width);
milestone[5] = "systemd-user-sessions.service";  # sessions
region_source = Image("dot-5.png");
region_image[5] = region_source.Scale(dot_width, dot_width);
for (r = 0; r < region_count; r++) {
    region_awake[r] = 0;
    region_woke_at[r] = 0;
}

fun smooth(start, end, t) {
    u = (t - start) / (end - start);
    if (u < 0) { u = 0; }
    if (u > 1) { u = 1; }
    return u * u * (3 - 2 * u);
}

fun place(seed_opacity, seed_fraction, reveal, spin, now) {
    for (r = 0; r < region_count; r++) {
        level = 0;
        if (region_awake[r]) {
            level = 1;
            if (motion) { level = smooth(region_woke_at[r], region_woke_at[r] + 0.7, now); }
        }
        region_glow[r] = 0.45 + 0.55 * level;
    }

    step = Math.Int((seed_fraction - seed_low) / (seed_high - seed_low) * (seed_steps - 1) + 0.5);
    if (step < 0) { step = 0; }
    if (step > seed_steps - 1) { step = seed_steps - 1; }
    seed.SetImage(seed_image[step]);
    seed.SetPosition(centre_x - seed_width[step] / 2, centre_y - seed_width[step] / 2, 0);
    seed.SetOpacity(seed_opacity);

    for (i = 0; i < dot_count; i++) {
        around = dot_lon[i] + spin;
        x = dot_cos_lat[i] * Math.Sin(around);
        depth = dot_cos_lat[i] * Math.Cos(around);
        y = dot_sin_lat[i] * cos_tilt - depth * sin_tilt;
        z = dot_sin_lat[i] * sin_tilt + depth * cos_tilt;
        lit = 0;
        if (reveal > 0) { lit = (reveal * reveal - (x * x + y * y)) / (0.5 * reveal); }
        if (lit < 0) { lit = 0; }
        if (lit > 1) { lit = 1; }
        r = dot_region[i];
        if (region_awake[r]) { dot[i].SetImage(region_image[r]); }
        dot[i].SetOpacity(lit * region_glow[r] * (0.2 + 0.4 * (z + 1)));
        dot[i].SetPosition(centre_x + x * radius - dot_width / 2, centre_y - y * radius - dot_width / 2, Math.Int(z * 100));
    }
}

tick = 0;
pending = 0;

fun refresh() {
    global.tick = global.tick + 1;
    global.pending = global.pending + 1;
    if (global.pending >= 2) {
        global.pending = 0;
        t = global.tick / 50;
        fraction = (0.12 + 0.74 * smooth(0, 2.5, t)) * (1 + 0.06 * Math.Sin(2.827433 * t + 0) + 0.03 * Math.Sin(5.215044 * t + 1));
        place(smooth(0, 0.6, t), fraction, 1.3 * smooth(0.36, 2.5, t), 0.174533 * t, t);
    }
}

fun status_update(status) {
    for (r = 0; r < region_count; r++) {
        if (status == milestone[r]) {
            if (region_awake[r] == 0) {
                global.region_awake[r] = 1;
                global.region_woke_at[r] = global.tick / 50;
            }
        }
    }
    # Reduced motion: no animation, but the still frame keeps telling the truth.
    if (motion == 0) { place(1, 0.86, 1.3, 0.314159, 0); }
}

Plymouth.SetUpdateStatusFunction(status_update);

if (motion) {
    Plymouth.SetRefreshFunction(refresh);
} else {
    # Reduced motion: one still frame of the gathered state.
    place(1, 0.86, 1.3, 0.314159, 0);
}
