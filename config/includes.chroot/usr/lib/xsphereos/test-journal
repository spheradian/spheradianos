#!/bin/sh
# Test only: when scripts/boot-test.py asks for it, copy the journal of the
# graphical session and its dependencies to the first serial port, which the
# boot test records and prints when a check fails.
#
# The request is a QEMU fw_cfg entry that only the boot test sets, so this
# exits at once on real hardware and in any other virtual machine.
set -u

flag=/sys/firmware/qemu_fw_cfg/by_name/opt/xsphereos/test-journal/raw

modprobe qemu_fw_cfg 2>/dev/null || true
[ -e "$flag" ] || exit 0

# Give the session time to start, fail and restart before taking the copy.
sleep 60

{
	echo "=== xsphereos-test-journal: session units ==="
	journalctl -b --no-pager -o short-monotonic \
		-u xsphere-session.service -u seatd.service -u systemd-logind.service \
		-u plymouth-quit.service -u plymouth-quit-wait.service
	echo "=== xsphereos-test-journal: unit states ==="
	systemctl --no-pager --failed
	systemctl --no-pager status --full xsphere-session.service
	echo "=== xsphereos-test-journal: kernel graphics ==="
	journalctl -b --no-pager -o short-monotonic -k --grep 'drm|fb|virtio|simpledrm'
	echo "=== xsphereos-test-journal: end ==="
} >/dev/ttyS0 2>&1
