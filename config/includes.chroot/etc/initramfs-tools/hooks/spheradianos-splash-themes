#!/bin/sh
# Debian's plymouth hook copies only the default theme into the initramfs.
# Add the reduced-motion variant so it can be selected at boot.
set -eu

PREREQ="plymouth"

prereqs() {
	echo "$PREREQ"
}

case "${1:-}" in
prereqs)
	prereqs
	exit 0
	;;
esac

[ -n "${DESTDIR:-}" ] || {
	echo "spheradianos-splash-themes: DESTDIR is not set" >&2
	exit 1
}

themes="${SPHERADIAN_THEMES:-/usr/share/plymouth/themes}"
mkdir -p "${DESTDIR}/usr/share/plymouth/themes"
cp -r "${themes}/spheradian-still" "${DESTDIR}/usr/share/plymouth/themes/"
