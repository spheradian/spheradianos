[Unit]
Description=SpheradianOS M1 Prototype Session (Wayland Kiosk + Fallback)
After=systemd-user-sessions.service seatd.service plymouth-quit-wait.service
# tty1 has one owner per boot, chosen by the same kernel switch: this session,
# or (with spheradian.session=console) the autologin getty, which carries the
# inverse condition in getty@tty1.service.d/spheradian-session.conf. Do not add a
# Conflicts= on the getty here: it is applied when the boot transaction is
# built, before this condition is checked, so it stops the getty even when the
# session is then skipped, leaving tty1 empty.
ConditionKernelCommandLine=!spheradian.session=console

[Service]
Slice=spheradian-session.slice
User=spheradian
Group=spheradian
SupplementaryGroups=video render input
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
ExecStart=/usr/lib/spheradianos/spheradian-session
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
