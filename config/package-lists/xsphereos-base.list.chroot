# XSphereOS M0 base manifest.
# Rule: every package has a one-line justification on the comment line directly above it.
# No justification, no package. Inline comments are not allowed: live-build passes them to apt.
# live-boot / live-config / the kernel are added by live-build itself.

# init system (kept, see design doc 3.4)
systemd-sysv

# system message bus, required by systemd-logind and later by the session
dbus

# device management
udev

# login and getty tooling
login

# interactive shell for the M0 console
bash

# network inspection (ip)
iproute2

# basic connectivity check
iputils-ping

# TLS trust store for later network use
ca-certificates

# pager for logs
less

# minimal editor for on-device debugging
nano

# boot splash daemon and script plugin (docs/BOOT-EXPERIENCE.md, B1)
plymouth

# fc-match and fc-cache, called by Debian's plymouth initramfs hook for any graphical theme
fontconfig

# live-config creates the live user only when this package is installed
user-setup

# fast initramfs compression/decompression for quicker early boot (ADR-004)
zstd
