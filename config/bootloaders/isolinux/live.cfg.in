label live-amd64
	menu label ^XSphereOS Live (amd64)
	menu default
	linux /live/vmlinuz
	initrd /live/initrd.img
	append @APPEND_LIVE@ vga=current

label live-amd64-failsafe
	menu label XSphereOS Live (amd64 fail-safe mode)
	linux /live/vmlinuz
	initrd /live/initrd.img
	append @APPEND_LIVE_FAILSAFE@
